{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/david-brandt-the-icelander/human-assisted-software-development/main/Agents/Knowledge/schemas/observability.schema.json",
  "title": "Observability",
  "description": "Signals the code emits: what each means, its unit and dimensions, who can read it, and how long it is kept. Readings are kept elsewhere. Fields not named here are allowed.",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/document"
    }
  ],
  "properties": {
    "kind": {
      "const": "observability"
    },
    "entities": {
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/entity"
          }
        ],
        "properties": {
          "signalType": {
            "type": "string",
            "minLength": 1,
            "description": "For example metric, log, trace, alarm, event or health-check."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "dimensions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "access": {
            "type": "string",
            "minLength": 1
          },
          "retention": {
            "type": "string",
            "minLength": 1
          },
          "cadence": {
            "type": "string",
            "minLength": 1
          },
          "excludes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "signalType",
          "meaning"
        ]
      }
    }
  }
}
