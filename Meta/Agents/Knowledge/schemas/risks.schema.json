{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/david-brandt-the-icelander/human-assisted-software-development/main/Agents/Knowledge/schemas/risks.schema.json",
  "title": "Risks",
  "description": "What could go wrong, how likely and how bad it is, and what is being done about it. Fields not named here are allowed.",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/document"
    }
  ],
  "properties": {
    "kind": {
      "const": "risks"
    },
    "entities": {
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/entity"
          }
        ],
        "properties": {
          "likelihood": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "mitigation": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "likelihood",
          "impact"
        ]
      }
    }
  }
}
