{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/david-brandt-the-icelander/human-assisted-software-development/main/Agents/Knowledge/schemas/verification.schema.json",
  "title": "Verification",
  "description": "How a behavior is checked: the criteria and the automated or manual checks. Results are readings, kept elsewhere. Fields not named here are allowed.",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/document"
    }
  ],
  "properties": {
    "kind": {
      "const": "verification"
    },
    "entities": {
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/entity"
          }
        ],
        "properties": {
          "subject": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/reference"
            }
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "description": "automated or manual"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type"
              ]
            }
          }
        },
        "required": [
          "criteria",
          "checks"
        ]
      }
    }
  }
}
