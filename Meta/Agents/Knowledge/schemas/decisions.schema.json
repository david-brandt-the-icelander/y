{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/david-brandt-the-icelander/human-assisted-software-development/main/Agents/Knowledge/schemas/decisions.schema.json",
  "title": "Decisions",
  "description": "Decisions taken, and decisions waiting on someone: context, options with their consequences, the choice and why. Fields not named here are allowed.",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/document"
    }
  ],
  "properties": {
    "kind": {
      "const": "decisions"
    },
    "entities": {
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/entity"
          }
        ],
        "properties": {
          "context": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "consequences": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "title"
              ]
            }
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "decidedBy": {
            "type": "string",
            "minLength": 1
          },
          "decidedOn": {
            "type": "string",
            "minLength": 1
          },
          "waitingOn": {
            "type": "string",
            "minLength": 1
          },
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/reference"
            }
          }
        },
        "required": [
          "status",
          "context"
        ]
      }
    }
  }
}
