{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/david-brandt-the-icelander/human-assisted-software-development/main/Agents/Knowledge/schemas/blockers.schema.json",
  "title": "Blockers",
  "description": "What is blocked, by what, what would unblock it, and who can. Fields not named here are allowed.",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/document"
    }
  ],
  "properties": {
    "kind": {
      "const": "blockers"
    },
    "entities": {
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/entity"
          }
        ],
        "properties": {
          "blocked": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/reference"
            }
          },
          "cause": {
            "type": "string",
            "minLength": 1
          },
          "unblockWhen": {
            "type": "string",
            "minLength": 1
          },
          "canUnblock": {
            "type": "string",
            "minLength": 1
          },
          "since": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "blocked",
          "unblockWhen"
        ]
      }
    }
  }
}
