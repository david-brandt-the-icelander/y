{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/david-brandt-the-icelander/human-assisted-software-development/main/Agents/Knowledge/schemas/contracts.schema.json",
  "title": "Contracts",
  "description": "Promises made to something outside the folder: an API, a message, a file format, a stored shape, and what may and may not change. Fields not named here are allowed.",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/document"
    }
  ],
  "properties": {
    "kind": {
      "const": "contracts"
    },
    "entities": {
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/entity"
          }
        ],
        "properties": {
          "contractType": {
            "type": "string",
            "minLength": 1,
            "description": "For example http-api, message, file-format, persistence, library-api."
          },
          "consumers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "guarantees": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "compatibility": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "contractType"
        ]
      }
    }
  }
}
