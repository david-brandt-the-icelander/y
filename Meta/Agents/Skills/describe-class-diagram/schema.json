{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Class diagram",
  "description": "Source, folder and diagram paths are relative to the repository root; $schema is relative to the JSON file. IDs are unique within their node collection; relationship endpoints reference declared node IDs.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "class"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "folder": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "symbol"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "types": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "class",
              "record",
              "struct",
              "interface",
              "enum",
              "type"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "external": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "sources",
          "members"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "inherits",
              "implements",
              "depends-on"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "from",
          "to",
          "kind",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "kind",
    "title",
    "folder",
    "description",
    "sources",
    "types",
    "relationships"
  ],
  "additionalProperties": false
}
