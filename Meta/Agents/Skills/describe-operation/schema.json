{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operations",
  "description": "Source, folder and view paths are relative to the repository root; $schema is relative to the JSON file. Entity IDs are unique within the view; relatedViews point at other views' files.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "operation"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "folder": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "symbol"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "symbol"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "entrypoint": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "symbol"
            ],
            "additionalProperties": false
          },
          "action": {
            "enum": [
              "command",
              "query"
            ],
            "description": "command when it changes something, query when it only reads. Judge by the effect, not the method name or the transport."
          },
          "transport": {
            "type": "string",
            "minLength": 1,
            "description": "How a caller reaches it, such as POST /api/scores, an exported function, a message or a scheduled job."
          },
          "authorization": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "minLength": 1
          },
          "failures": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "sources",
          "entrypoint",
          "action",
          "authorization",
          "result",
          "failures"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "relatedViews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "component",
              "class",
              "state",
              "deployment",
              "use-case",
              "user-journey",
              "capability",
              "feature",
              "operation"
            ]
          },
          "folder": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "relationship": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "folder",
          "path",
          "relationship"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "$schema",
    "kind",
    "title",
    "folder",
    "description",
    "sources",
    "entities",
    "relatedViews"
  ],
  "additionalProperties": false
}
