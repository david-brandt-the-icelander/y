{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "User journey",
  "description": "Source, folder and view paths are relative to the repository root; $schema is relative to the JSON file. Entity IDs are unique within the view; relatedViews point at other views' files.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "user-journey"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "folder": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "symbol"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "symbol"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "persona": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "stages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "context": {
                  "type": "string",
                  "minLength": 1
                },
                "touchpoint": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "outcome": {
                  "type": "string",
                  "minLength": 1
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "symbol": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "path",
                      "symbol"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "id",
                "context",
                "touchpoint",
                "action",
                "outcome",
                "sources"
              ],
              "additionalProperties": false
            },
            "minItems": 2
          },
          "actorDocument": {
            "type": "string",
            "minLength": 1
          },
          "supportingActors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "actorDocument": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "actorDocument"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "sources",
          "persona",
          "goal",
          "stages",
          "actorDocument"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "relatedViews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "component",
              "class",
              "state",
              "deployment",
              "use-case",
              "user-journey",
              "capability",
              "feature",
              "operation"
            ]
          },
          "folder": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "relationship": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "folder",
          "path",
          "relationship"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "$schema",
    "kind",
    "title",
    "folder",
    "description",
    "sources",
    "entities",
    "relatedViews"
  ],
  "additionalProperties": false
}
