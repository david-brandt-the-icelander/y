{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deployment diagram",
  "description": "Source, folder and diagram paths are relative to the repository root; $schema is relative to the JSON file. IDs are unique within their node collection; relationship endpoints reference declared node IDs.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "deployment"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "folder": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "symbol"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "process",
              "host",
              "database",
              "cache",
              "external-service",
              "client"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "actor": {
            "type": "string",
            "minLength": 1,
            "description": "Repository-relative path to the actor's file, Actors/<name>.md, when this client or external service is an actor: someone or something outside the system with goals of its own toward it. Only on nodes of kind client or external-service."
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "description"
        ],
        "additionalProperties": false,
        "if": {
          "required": [
            "actor"
          ]
        },
        "then": {
          "properties": {
            "kind": {
              "enum": [
                "client",
                "external-service"
              ]
            }
          }
        }
      },
      "minItems": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "deployedTo": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "source",
          "deployedTo",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "hosts",
              "routes",
              "connects-to"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "from",
          "to",
          "kind",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "kind",
    "title",
    "folder",
    "description",
    "sources",
    "nodes",
    "artifacts",
    "relationships"
  ],
  "additionalProperties": false
}
