{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Component diagram",
  "description": "Source, folder and diagram paths are relative to the repository root; $schema is relative to the JSON file. IDs are unique within their node collection; relationship endpoints reference declared node IDs.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "component"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "folder": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "symbol"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "folder": {
            "type": "string",
            "minLength": 1,
            "description": "Repository-relative directory holding the component. Required unless external is true."
          },
          "diagram": {
            "type": "string",
            "minLength": 1
          },
          "external": {
            "type": "boolean",
            "description": "True for a component outside this repository (another repository's service, a managed database, a third party). It has no folder or diagram."
          },
          "actor": {
            "type": "string",
            "minLength": 1,
            "description": "Repository-relative path to the actor's file, Actors/<name>.md, when this external component is an actor (an external system with goals of its own toward this one) rather than infrastructure the system merely uses. Only with external true."
          }
        },
        "required": [
          "id",
          "name",
          "responsibility"
        ],
        "additionalProperties": false,
        "if": {
          "properties": {
            "external": {
              "const": true
            }
          },
          "required": [
            "external"
          ]
        },
        "then": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "folder"
                ]
              },
              {
                "required": [
                  "diagram"
                ]
              }
            ]
          }
        },
        "else": {
          "required": [
            "folder"
          ],
          "not": {
            "required": [
              "actor"
            ]
          }
        }
      },
      "minItems": 1
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "contains",
              "depends-on"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "from",
          "to",
          "kind",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "kind",
    "title",
    "folder",
    "description",
    "sources",
    "components",
    "relationships"
  ],
  "additionalProperties": false
}
